# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./campus_resolve.db
# Managed PostgreSQL (e.g., Render, Neon, Supabase):
# DATABASE_URL=postgresql://campusresolve_user:password@dpg-xxxxxx.render.com/campusresolve
PORT=8000
HOST=127.0.0.1

# AI Classification Configuration (Gemini 3.8 Flash as Primary, Groq as Secondary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Set MOCK_MODE=true to run without an active Groq API key for offline/hackathon demos
MOCK_MODE=false

# Demo Time Compression: Set to e.g. 3600 so 1 real second = 1 simulated hour (for rapid SLA demo)
DEBUG_TIME_SCALE=1

# SMTP Configuration for real email sending via Gmail
# Provide these credentials in your local .env to enable real email dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
 
# Optional HTTPS Email API (Alternative for cloud environments like Render that block raw SMTP ports)
# Sign up at resend.com to obtain a free API key (3000 free emails/month, no credit card required)
RESEND_API_KEY=
RESEND_FROM=CampusResolve <onboarding@resend.dev>

